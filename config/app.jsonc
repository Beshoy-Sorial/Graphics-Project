{
  "start-scene": "menu",
  "window": {
    "title": "Boxing Fighter Championship",
    "size": { "width": 1280, "height": 720 },
    "fullscreen": false
  },
  "scene": {
    "audience": {
      "numRows": 3,
      "peoplePerRow": [40, 50, 60],
      "startRadius": 7.5,
      "rowSpacing": 1.5,
      "heightStep": 0.9,
      "angleRandomOffset": 0.2,
      "torsoMaterials": [
        "aud_red",
        "aud_blue",
        "aud_green",
        "aud_yellow",
        "aud_purple",
        "aud_cyan",
        "aud_orange",
        "aud_black"
      ]
    },
    "arenaColorOptions": [
      { "name": "Dark Gray",    "color": [0.18, 0.18, 0.18, 1.0] },
      { "name": "White",        "color": [0.9, 0.9, 0.9, 1.0] },
      { "name": "Deep Blue",    "color": [0.1, 0.2, 0.5, 1.0] },
      { "name": "Forest Green", "color": [0.1, 0.4, 0.1, 1.0] },
      { "name": "Dark Red",     "color": [0.5, 0.1, 0.1, 1.0] },
      { "name": "Golden",       "color": [0.7, 0.6, 0.1, 1.0] },
      { "name": "Purple",       "color": [0.4, 0.1, 0.5, 1.0] },
      { "name": "Ocean Blue",   "color": [0.1, 0.5, 0.7, 1.0] }
    ],
    "renderer": {
      // Arena backdrop: "Circus Arena" panorama by Oliksiy Yakovlyev (Poly Haven, CC0)
      "sky": "assets/textures/arena/arena_panorama.jpg",
      "skySegments": 96,
      "skyTint": [0.46, 0.43, 0.44, 1.0],
      // arena-final.frag: bloom + ACES tone mapping + warm grade + vignette + gamma (Phase-2 postprocess)
      "postprocess": "assets/shaders/postprocess/arena-final.frag",
      "hdr": true,
      "msaa": 4,
      "exposure": 0.85,
      "bloom": { "strength": 0.09, "threshold": 1.1, "knee": 0.6, "iterations": 4 },
      "shadows": { "size": 2048, "normalOffset": 0.025, "bias": 0.0003 },
      "ambient": { "sky": [0.030, 0.030, 0.040], "ground": [0.018, 0.013, 0.010] },
      "fog": { "color": [0.012, 0.010, 0.012], "density": 0.022 },
      "weather": true
    },
    "assets": {
      "shaders": {
        "tinted": {
          "vs": "assets/shaders/tinted.vert",
          "fs": "assets/shaders/tinted.frag"
        },
        "textured": {
          "vs": "assets/shaders/textured.vert",
          "fs": "assets/shaders/textured.frag"
        },
        "lit": {
          "vs": "assets/shaders/lit.vert",
          "fs": "assets/shaders/lit.frag"
        }
      },
      "samplers": {
        "default": { "MAX_ANISOTROPY": 16.0 }
      },
      "textures": {
        "ring":  "assets/textures/ring.png",
        "grass": "assets/textures/grass_ground_d.jpg",
        "moon":  "assets/textures/moon.jpg",
        "wood":  "assets/textures/wood.jpg",
        // "Herringbone Parquet" by Sergej Majboroda & Jenelle van Heerden (Poly Haven, CC0)
        "parquet":           "assets/textures/arena/parquet_albedo.jpg",
        "parquet_normal":    "assets/textures/arena/parquet_normal.jpg",
        "parquet_roughness": "assets/textures/arena/parquet_roughness.jpg",
        // Solid 1x1 maps (specular intensity / roughness) for the untextured materials
        "spec_skin":    "color:46,40,36,255",
        "rough_skin":   "color:150,150,150,255",
        "spec_satin":   "color:80,80,80,255",
        "rough_satin":  "color:118,118,118,255",
        "spec_cloth":   "color:20,20,20,255",
        "rough_cloth":  "color:185,185,185,255",
        "spec_canvas":  "color:34,34,34,255",
        "rough_canvas": "color:165,165,165,255",
        "spec_floor":   "color:150,150,150,255"
      },
      "meshes": {
        "torso":     "assets/models/torso.obj",
        "head":      "assets/models/head.obj",
        "left_arm":  "assets/models/left_arm.obj",
        "right_arm": "assets/models/right_arm.obj",
        "left_leg":  "assets/models/left_leg.obj",
        "right_leg": "assets/models/right_leg.obj",
        // Low-poly copies for the crowd (generated by tools/generate_lods.py)
        "torso_lod":     "assets/models/torso_lod.obj",
        "left_arm_lod":  "assets/models/left_arm_lod.obj",
        "right_arm_lod": "assets/models/right_arm_lod.obj",
        "left_leg_lod":  "assets/models/left_leg_lod.obj",
        "right_leg_lod": "assets/models/right_leg_lod.obj",
        "ring":      "assets/models/ring.obj",
        "plane":     "assets/models/plane.obj",
        "cube":      "assets/models/cube.obj"
      },
      "materials": {
        // ── Fighters (lit: Blinn-Phong, shadows, rim light) ──────────────────
        "skin":        { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.95, 0.76, 0.62], "specular_map": "spec_skin",  "roughness_map": "rough_skin",  "rim": 0.55, "sampler": "default" },
        "torso_red":   { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.85, 0.12, 0.12], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_blue":  { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.15, 0.35, 0.90], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_white": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.90, 0.90, 0.90], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.5, "sampler": "default" },
        "torso_green": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.10, 0.70, 0.15], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_yellow":{ "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.85, 0.70, 0.10], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_purple":{ "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.50, 0.12, 0.75], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_cyan":  { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.10, 0.70, 0.80], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_orange":{ "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.95, 0.50, 0.10], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.6, "sampler": "default" },
        "torso_black": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.16, 0.16, 0.17], "specular_map": "spec_satin", "roughness_map": "rough_satin", "rim": 0.7, "sampler": "default" },
        "skin_yellow": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.90, 0.80, 0.10], "specular_map": "spec_skin",  "roughness_map": "rough_skin",  "rim": 0.55, "sampler": "default" },

        // ── Crowd (lit, matte cloth, slightly muted colours) ─────────────────
        "aud_red":    { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.70, 0.16, 0.15], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_blue":   { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.16, 0.30, 0.70], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_green":  { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.16, 0.52, 0.20], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_yellow": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.75, 0.62, 0.18], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_purple": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.42, 0.18, 0.58], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_cyan":   { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.16, 0.55, 0.62], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_orange": { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.80, 0.42, 0.14], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_black":  { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.20, 0.20, 0.22], "specular_map": "spec_cloth", "roughness_map": "rough_cloth", "rim": 0.35, "sampler": "default" },
        "aud_skin":   { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.85, 0.66, 0.52], "specular_map": "spec_skin",  "roughness_map": "rough_skin",  "rim": 0.35, "sampler": "default" },
        "bleacher":   { "type": "lit", "shader": "lit", "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } }, "tint": [0.20, 0.07, 0.07], "specular_map": "spec_canvas", "roughness_map": "rough_canvas", "sampler": "default" },

        // ── Environment ──────────────────────────────────────────────────────
        "ring_mat": {
          "type": "lit",
          "shader": "lit",
          "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
          "albedo_map":    "ring",
          "specular_map":  "spec_canvas",
          "roughness_map": "rough_canvas",
          "recolor": true,
          "sampler": "default"
        },
        "floor_mat": {
          "type": "lit",
          "shader": "lit",
          "pipelineState": { "faceCulling": { "enabled": false }, "depthTesting": { "enabled": true } },
          "albedo_map":    "parquet",
          "normal_map":    "parquet_normal",
          "roughness_map": "parquet_roughness",
          "specular_map":  "spec_floor",
          "uvScale": [16.0, 16.0],
          "recolor": true,
          "sampler": "default"
        }
      }
    },

    "world": [

      // ═══════════════════════════════════════════════════════════════════
      // LIGHTS (linear HDR values: > 1 is allowed, the image is tone mapped)
      // ═══════════════════════════════════════════════════════════════════
      {
        "name": "CenterArenaSpot",
        "position": [0.0, 10.0, 0.0],
        "rotation": [-90, 0, 0],
        "components": [{
          "type": "Light",
          "lightType": "spot",
          "diffuse":  [3.3, 3.15, 2.9],
          "specular": [3.3, 3.15, 2.9],
          "ambient":  [0.012, 0.012, 0.012],
          "attenuationConstant":  1.0,
          "attenuationLinear":    0.022,
          "attenuationQuadratic": 0.0019,
          "innerConeAngle": 17.0,
          "outerConeAngle": 30.0,
          "castShadows": true
        }]
      },
      {
        "name": "RedCornerLight",
        "position": [-4.5, 4.5, 0.0],
        "components": [{
          "type": "Light",
          "lightType": "point",
          "diffuse":  [2.6, 0.18, 0.12],
          "specular": [2.0, 0.25, 0.20],
          "ambient":  [0.0, 0.0, 0.0],
          "attenuationConstant": 1.0,
          "attenuationLinear": 0.09,
          "attenuationQuadratic": 0.06
        }]
      },
      {
        "name": "BlueCornerLight",
        "position": [4.5, 4.5, 0.0],
        "components": [{
          "type": "Light",
          "lightType": "point",
          "diffuse":  [0.12, 0.35, 2.8],
          "specular": [0.20, 0.35, 2.0],
          "ambient":  [0.0, 0.0, 0.0],
          "attenuationConstant": 1.0,
          "attenuationLinear": 0.09,
          "attenuationQuadratic": 0.06
        }]
      },
      {
        "name": "PurpleMagentaRim",
        "rotation": [20, 180, 0],
        "components": [{
          "type": "Light",
          "lightType": "directional",
          "diffuse":  [0.10, 0.02, 0.18],
          "specular": [0.30, 0.06, 0.50],
          "ambient":  [0.0, 0.0, 0.0]
        }]
      },
      {
        "name": "GoldenBroadcastLeft",
        "rotation": [-35, 45, 0],
        "components": [{
          "type": "Light",
          "lightType": "directional",
          "diffuse":  [0.42, 0.33, 0.20],
          "specular": [0.30, 0.25, 0.15],
          "ambient":  [0.0, 0.0, 0.0]
        }]
      },
      {
        "name": "AmberBroadcastRight",
        "rotation": [-35, -135, 0],
        "components": [{
          "type": "Light",
          "lightType": "directional",
          "diffuse":  [0.34, 0.27, 0.16],
          "specular": [0.25, 0.20, 0.12],
          "ambient":  [0.0, 0.0, 0.0]
        }]
      },
      // ═══════════════════════════════════════════════════════════════════
      // CAMERA
      // ═══════════════════════════════════════════════════════════════════
      {
        "name": "Camera",
        "position": [0.0, 2.6, 6.5],
        "rotation": [-14, 0, 0],
        "components": [
          { "type": "Camera", "fovY": 55, "near": 0.05, "far": 200 },
          { "type": "Free Camera Controller" }
        ]
      },


      {
        "name": "Ring",
        "position": [0, 0, 0],
        "scale": [0.83, 0.83, 0.83],
        "components": [
          { "type": "Mesh Renderer", "mesh": "ring", "material": "ring_mat" }
        ]
      },
      {
        "name": "Floor",
        "position": [0, -0.02, 0],
        "rotation": [-90, 0, 0],
        "scale": [30, 30, 1],
        "components": [
          { "type": "Mesh Renderer", "mesh": "plane", "material": "floor_mat", "castShadows": false }
        ]
      },

      {
        "name": "Player_Torso",
        "position": [-1.3, 1.5, 0.0],
        "rotation": [0, 0, 0],
        "scale": [0.351, 0.351, 0.351],
        "components": [
          { "type": "Mesh Renderer", "mesh": "torso", "material": "torso_red" },
          { "type": "Fighter", "isPlayer": true, "maxHealth": 100 }
        ],
        "children": [
          {
            "name": "Player_Head",
            "position": [-0.18, 1.102, -0.244],
            "rotation": [0, -90, 0],
            "scale": [0.191, 0.191, 0.191],
            "components": [
              { "type": "Mesh Renderer", "mesh": "head", "material": "skin" }
            ]
          },
          {
            "name": "Player_Left_Shoulder",
            "position": [0.6, 1.0, 0.0],
            "children": [{
              "name": "Player_Left_Arm",
              "position": [-0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "left_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "Player_Right_Shoulder",
            "position": [-0.6, 1.0, 0.0],
            "children": [{
              "name": "Player_Right_Arm",
              "position": [0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "right_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "Player_Left_Leg",
            "position": [0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "left_leg", "material": "skin" }
            ]
          },
          {
            "name": "Player_Right_Leg",
            "position": [-0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "right_leg", "material": "skin" }
            ]
          }
        ]
      },

      {
        "name": "AI_Torso",
        "position": [1.3, 1.5, 0.0],
        "rotation": [0, 180, 0],
        "scale": [0.351, 0.351, 0.351],
        "components": [
          { "type": "Mesh Renderer", "mesh": "torso", "material": "torso_blue" },
          { "type": "Fighter", "isPlayer": false, "maxHealth": 100 }
        ],
        "children": [
          {
            "name": "AI_Head",
            "position": [-0.18, 1.102, -0.244],
            "rotation": [0, -90, 0],
            "scale": [0.191, 0.191, 0.191],
            "components": [
              { "type": "Mesh Renderer", "mesh": "head", "material": "skin" }
            ]
          },
          {
            "name": "AI_Left_Shoulder",
            "position": [0.6, 1.0, 0.0],
            "children": [{
              "name": "AI_Left_Arm",
              "position": [-0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "left_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "AI_Right_Shoulder",
            "position": [-0.6, 1.0, 0.0],
            "children": [{
              "name": "AI_Right_Arm",
              "position": [0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "right_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "AI_Left_Leg",
            "position": [0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "left_leg", "material": "skin" }
            ]
          },
          {
            "name": "AI_Right_Leg",
            "position": [-0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "right_leg", "material": "skin" }
            ]
          }
        ]
      },

      {
        "name": "Referee_Torso",
        "position": [0.0, 1.5, -2.0],
        "rotation": [0, 0, 0],
        "scale": [0.351, 0.351, 0.351],
        "components": [
          { "type": "Mesh Renderer", "mesh": "torso", "material": "torso_white" },
          { "type": "Fighter", "isPlayer": false, "maxHealth": 100 }
        ],
        "children": [
          {
            "name": "Referee_Head",
            "position": [-0.18, 1.102, -0.244],
            "rotation": [0, -90, 0],
            "scale": [0.152, 0.152, 0.152],
            "components": [
              { "type": "Mesh Renderer", "mesh": "head", "material": "skin" }
            ]
          },
          {
            "name": "Referee_Left_Shoulder",
            "position": [0.6, 1.0, 0.0],
            "children": [{
              "name": "Referee_Left_Arm",
              "position": [-0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "left_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "Referee_Right_Shoulder",
            "position": [-0.6, 1.0, 0.0],
            "children": [{
              "name": "Referee_Right_Arm",
              "position": [0.223, -1.792, -0.216],
              "rotation": [0, 0, 0],
              "scale": [0.074, 0.074, 0.074],
              "components": [
                { "type": "Mesh Renderer", "mesh": "right_arm", "material": "skin" }
              ]
            }]
          },
          {
            "name": "Referee_Left_Leg",
            "position": [0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "left_leg", "material": "skin" }
            ]
          },
          {
            "name": "Referee_Right_Leg",
            "position": [-0.368, -2.92, -0.135],
            "rotation": [0, 0, 0],
            "scale": [0.28, 0.28, 0.28],
            "components": [
              { "type": "Mesh Renderer", "mesh": "right_leg", "material": "skin" }
            ]
          }
        ]
      }
    ]
  }
}
